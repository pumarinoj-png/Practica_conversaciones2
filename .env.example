# Clave de la API de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo (opcional)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Contraseña para entrar a /admin
ADMIN_PASSWORD=

# Base de datos Upstash Redis (Vercel la crea automáticamente al conectarla).
# Se aceptan estos nombres o los equivalentes KV_REST_API_URL / KV_REST_API_TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
